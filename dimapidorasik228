-- // ЛОГИКА ВКЛАДОК

local function SwitchTab(to)

    if to == "Flash" then

        FlashFrame.Visible = true

        SpeedFrame.Visible = false

        FlashTabBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 0)

        SpeedTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        Stroke.Color = Color3.fromRGB(255, 0, 0)

    else

        FlashFrame.Visible = false

        SpeedFrame.Visible = true

        FlashTabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        SpeedTabBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 120)

        Stroke.Color = Color3.fromRGB(180, 100, 255)

    end

end



FlashTabBtn.MouseButton1Click:Connect(function() SwitchTab("Flash") end)

SpeedTabBtn.MouseButton1Click:Connect(function() SwitchTab("Speed") end)



-- // ЛОГИКА FLASH (SLIDER)

local function updateSlider(x)

    local size = math.clamp((x - Slider.AbsolutePosition.X) / Slider.AbsoluteSize.X, 0, 1)

    sliderValue = size

    Fill.Size = UDim2.new(size, 0, 1, 0)

    Handle.Position = UDim2.new(size, 0, 0.5, 0)

    Percent.Text = math.floor(size * 100) .. "%"

    config.porcentaje = math.floor(size * 100)

    GuardarAjustes()

end



Slider.InputBegan:Connect(function(i)

    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then

        draggingSlider = true

        Main.Draggable = false

        updateSlider(i.Position.X)

    end

end)



UIS.InputChanged:Connect(function(i)

    if draggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then

        updateSlider(i.Position.X)

    end

end)



UIS.InputEnded:Connect(function(i)

    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then

        draggingSlider = false

        Main.Draggable = true

    end

end)



ToggleFlashBtn.MouseButton1Click:Connect(function()

    flashEnabled = not flashEnabled

    ToggleFlashBtn.Text = flashEnabled and "FLASH: ON" or "FLASH: OFF"

    ToggleFlashBtn.TextColor3 = flashEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)

end)



