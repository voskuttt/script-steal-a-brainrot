    hubMinimized = not hubMinimized

    Content.Visible = not hubMinimized

    TabBar.Visible = not hubMinimized

    MinBtn.Text = hubMinimized and "+" or "—"

    Main:TweenSize(hubMinimized and UDim2.new(0, 260, 0, 30) or UDim2.new(0, 260, 0, 190), "Out", "Quad", 0.2, true)

    config.minimo = hubMinimized

    GuardarAjustes()

end)



KickBtn.MouseButton1Click:Connect(function() player:Kick("self Kick by abyss hub") end)



Main:GetPropertyChangedSignal("Position"):Connect(function()

    config.posX = Main.Position.X.Scale

    config.posOffset = Main.Position.X.Offset

    config.posY = Main.Position.Y.Scale

    config.posYOffset = Main.Position.Y.Offset

    GuardarAjustes()

end)



-- // РАБОЧИЕ ЦИКЛЫ

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)

    if not flashEnabled then return end

    local start = os.clock()

    local conn

    conn = RunService.RenderStepped:Connect(function()

        if not prompt or not prompt.Parent then conn:Disconnect() return end

        if (os.clock() - start) / prompt.HoldDuration >= sliderValue then

            conn:Disconnect()

            local tool = player.Character:FindFirstChildOfClass("Tool")

            if tool then tool:Activate() end

        end

    end)

    prompt.PromptButtonHoldEnded:Connect(function() if conn then conn:Disconnect() end end)

end)



RunService.Heartbeat:Connect(function()

    local char = player.Character

    local hum = char and char:FindFirstChildOfClass("Humanoid")

    local root = char and char:FindFirstChild("HumanoidRootPart")

   

    if hum and root and speedEnabled and hum.MoveDirection.Magnitude > 0 then

        root.Velocity = Vector3.new(hum.MoveDirection.X * speedValue, root.Velocity.Y, hum.MoveDirection.Z * speedValue)

    end

end) 
